---
import '@fontsource/geist/400.css';
import '@fontsource/geist/500.css';
import '@fontsource/geist/600.css';
import '@fontsource/geist/700.css';
import '@fontsource/geist-mono/400.css';
import '@fontsource/geist-mono/500.css';
import '../styles/landing.css';
import '../styles/components/hero.css';
import '../styles/components/nav-react.css';
import '../styles/components/services.css';
import '../styles/components/why-us.css';
import '../styles/components/process.css';
import '../styles/components/cta.css';

import { translations, type Locale } from '../i18n/translations';
import { getLocaleFromUrl, getText } from '../i18n/index';
import Nav from '../components/react/Nav.jsx';
import Hero from '../components/landing/Hero.astro';
import WhyUs from '../components/landing/WhyUs.astro';
import Services from '../components/landing/Services.astro';
import Projects from '../components/landing/Projects.astro';
import Testimonials from '../components/landing/Testimonials.astro';
import Process from '../components/landing/Process.astro';
import ContactForm from '../components/landing/ContactForm.astro';
import Footer from '../components/landing/Footer.astro';

const url = Astro.url;
const locale: Locale = getLocaleFromUrl(url);
const t = getText.bind(null, locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t('meta.desc')} />
    <meta property="og:title" content={t('meta.ogTitle')} />
    <meta property="og:description" content={t('meta.ogDesc')} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={t('meta.ogTitle')} />
    <meta name="twitter:description" content={t('meta.ogDesc')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{t('meta.title')}</title>
    <script is:inline>
      window.__I18N__ = {
        translations: JSON.parse(JSON.stringify({es:translations.es, en:translations.en}))
      };
      (function() {
        var params = new URLSearchParams(window.location.search);
        var lang = params.get('lang');
        if (lang === 'en' || lang === 'es') {
          document.documentElement.lang = lang;
        }
      })();
    </script>
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
    </style>
  </head>
  <body class="landing-body">
    <Nav client:load locale={locale} />

    <main id="main-content" style="padding-top: 4.5rem;">
      <Hero locale={locale} />
      <Services locale={locale} />
      <WhyUs locale={locale} />
      <Projects />
      <Testimonials />
      <Process locale={locale} />
      <ContactForm locale={locale} />
    </main>
    <Footer locale={locale} />

    <button
      id="scroll-top"
      aria-label={locale === 'en' ? 'Back to top' : 'Volver arriba'}
      title={locale === 'en' ? 'Back to top' : 'Volver arriba'}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="18 15 12 9 6 15"></polyline>
      </svg>
    </button>

    <script src="../scripts/main.js"></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var lang = document.documentElement.lang || 'es';
        var t = window.__I18N__.translations[lang];
        var isEnglish = lang === 'en';

        document.querySelectorAll('[data-i18n]').forEach(function(el) {
          var key = el.getAttribute('data-i18n');
          var keys = key.split('.');
          var val = t;
          try {
            for (var i = 0; i < keys.length; i++) {
              val = val[keys[i]];
            }
            if (val) el.textContent = val;
          } catch(e) {
            console.log('Translation error for key:', key);
          }
        });

        var scrollTopBtn = document.getElementById('scroll-top');
        if (scrollTopBtn) {
          scrollTopBtn.setAttribute('aria-label', isEnglish ? 'Back to top' : 'Volver arriba');
          scrollTopBtn.setAttribute('title', isEnglish ? 'Back to top' : 'Volver arriba');
        }
      });
    </script>
  </body>
</html>
