---
import { getTranslation, type Locale } from '../../i18n/index';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale);
const intro = t.servicesIntro;
const serviceEntries = Object.entries(t.services.items);
---

<section class="services section" id="servicios">
  <div class="container">
    <div class="services__intro reveal">
      <p class="eyebrow" data-i18n="servicesIntro.eyebrow">{intro.eyebrow}</p>
      <h2 class="display-lg" data-i18n="servicesIntro.headline">
        {intro.headline}
      </h2>
      <p class="services__sub" data-i18n="servicesIntro.sub">{intro.sub}</p>
    </div>

    <div class="services__header reveal">
      <p class="eyebrow" data-i18n="services.eyebrow">{t.services.eyebrow}</p>
    </div>

    <div class="services__grid">
      {serviceEntries.map(([key, item], i) => (
        <a href="#contacto" class={`service-card reveal ${i > 0 ? `reveal-delay-${Math.min(i, 6)}` : ''}`}>
          <h3 class="service-card__title" data-i18n={`services.items.${key}.title`}>{item.title}</h3>
          <p class="service-card__desc" data-i18n={`services.items.${key}.desc`}>{item.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
