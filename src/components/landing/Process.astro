---
import { getTranslation, type Locale } from '../../i18n/index';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale).process;
const steps = Object.entries(t.steps);
---

<section class="process section" id="proceso">
  <div class="container">
    <div class="process__header reveal">
      <p class="eyebrow" data-i18n="process.eyebrow">{t.eyebrow}</p>
      <h2 class="display-lg" data-i18n="process.headline">
        {t.headline}
      </h2>
    </div>

    <div class="process__list">
      {steps.map(([key, step], i) => (
        <div class={`process__step reveal ${i > 0 ? `reveal-delay-${Math.min(i, 6)}` : ''}`}>
          <div class="process__step-number" aria-hidden="true">{i + 1}</div>
          <div class="process__step-content">
            <h3 class="process__step-title" data-i18n={`process.steps.${key}.title`}>{step.title}</h3>
            <p class="process__step-desc" data-i18n={`process.steps.${key}.desc`}>{step.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
