---
import { getTranslation, type Locale } from '../../i18n/index';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale).cta;
---

<section class="contact section" id="contacto">
  <div class="container">
    <div class="contact__inner reveal">
      <p class="contact__closing" data-i18n="cta.closingPhrase">{t.closingPhrase}</p>

      <p class="eyebrow" data-i18n="cta.eyebrow">{t.eyebrow}</p>
      <h2 class="display-lg" data-i18n="cta.headline">
        {t.headline}
      </h2>
      <p class="contact__sub" data-i18n="cta.sub">
        {t.sub}
      </p>

      <form class="contact__form" id="contactForm">
        <div class="form__row">
          <div class="form__group">
            <label for="name" class="form__label" data-i18n="cta.nameLabel">{t.nameLabel}</label>
            <input
              type="text"
              id="name"
              name="name"
              class="form__input"
              placeholder={t.namePlaceholder}
              required
            />
          </div>

          <div class="form__group">
            <label for="email" class="form__label" data-i18n="cta.emailLabel">{t.emailLabel}</label>
            <input
              type="email"
              id="email"
              name="email"
              class="form__input"
              placeholder={t.emailPlaceholder}
              required
            />
          </div>
        </div>

        <div class="form__group">
          <label for="project" class="form__label" data-i18n="cta.projectLabel">{t.projectLabel}</label>
          <select id="project" name="project" class="form__input" required>
            <option value="" data-i18n="cta.projectPlaceholder">{t.projectPlaceholder}</option>
            <option value="Web" data-i18n="cta.projectWeb">{t.projectWeb}</option>
            <option value="Tienda online" data-i18n="cta.projectStore">{t.projectStore}</option>
            <option value="Sistema" data-i18n="cta.projectSystem">{t.projectSystem}</option>
            <option value="Otro" data-i18n="cta.projectOther">{t.projectOther}</option>
          </select>
        </div>

        <div class="form__group">
          <label for="message" class="form__label" data-i18n="cta.messageLabel">{t.messageLabel}</label>
          <textarea
            id="message"
            name="message"
            class="form__input form__textarea"
            placeholder={t.messagePlaceholder}
            rows="3"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary btn-lg form__submit">
          <span data-i18n="cta.button">{t.button}</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
          </svg>
        </button>
      </form>
    </div>
  </div>
</section>

<script src="../../scripts/contact-form.js"></script>
