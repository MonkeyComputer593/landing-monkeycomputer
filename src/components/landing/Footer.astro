---
import { getTranslation, type Locale } from '../../i18n/index';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslation(locale).footer;
---

<footer class="footer">
  <div class="divider"></div>
  <div class="container footer__inner">
    <div class="footer__brand">
      <a href="/" class="footer__logo" aria-label="Monkey Computer home">
        <span>Monkey Computer</span>
      </a>
      <p class="footer__tagline" data-i18n="footer.tagline">{t.tagline}</p>
      <p class="footer__credit">
        <span class="footer__dot" aria-hidden="true">/monkey/</span>
        <span data-i18n="footer.credit">{t.credit}</span>
      </p>

      <nav class="footer__social" aria-label="Redes sociales">
        <a href="https://github.com/MonkeyComputer593" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23a11.509 11.509 0 0 1 3.003-.404c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/company/monkey-computer/" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="LinkedIn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.883-.382-3.637-2.382-3.637-2.382 0-2.786 1.754-2.786 3.637v5.569h-3.554v-11h3.554v1.561h.049c.475-.9 1.637-1.848 3.055-1.848 2.963 0 3.397 1.894 3.397 4.574v6.437zM5.337 7.433c-1.145 0-2.073-.928-2.073-2.073 0-1.146.928-2.074 2.073-2.074 1.146 0 2.074.928 2.074 2.074 0 1.145-.928 2.073-2.074 2.073zm1.778 13.019H3.555v-11h3.56v11zm-1.78-6.243c0-1.036.838-1.876 1.877-1.876 1.038 0 1.876.84 1.876 1.876 0 1.036-.838 1.876-1.876 1.876zm11.402 6.243h-3.56v-5.992c0-2.427-1.08-4.082-3.16-4.082-1.918 0-3.002 1.294-3.002 2.944v5.13h-3.56v-11h3.56v1.384h.049c.817-.9 2.065-1.548 3.408-1.548 2.744 0 3.68 1.808 3.68 4.257v6.007z"/>
          </svg>
        </a>
        <a href="https://www.instagram.com/monkey.computer.ec/" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="Instagram">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.072 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
          </svg>
        </a>
        <a href="https://www.tiktok.com/@monkey.computer.ec" target="_blank" rel="noopener noreferrer" class="footer__social-link" aria-label="TikTok">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/>
          </svg>
        </a>
      </nav>
    </div>

    <nav class="footer__links" aria-label="Footer navegación">
      <div class="footer__col">
        <span class="footer__col-title" data-i18n="footer.servicios">{t.servicios}</span>
        <a href="#servicios" class="footer__link" data-i18n="footer.desarrolloWeb">{t.desarrolloWeb}</a>
        <a href="#servicios" class="footer__link" data-i18n="footer.ecommerce">{t.ecommerce}</a>
        <a href="#servicios" class="footer__link" data-i18n="footer.panelesAdmin">{t.panelesAdmin}</a>
        <a href="#servicios" class="footer__link" data-i18n="footer.chatbots">{t.chatbots}</a>
      </div>
      <div class="footer__col">
        <span class="footer__col-title" data-i18n="footer.empresa">{t.empresa}</span>
        <a href="#proceso" class="footer__link" data-i18n="footer.proceso">{t.proceso}</a>
        <a href="#proyectos" class="footer__link" data-i18n="footer.proyectos">{t.proyectos}</a>
        <a href="#contacto" class="footer__link" data-i18n="footer.contacto">{t.contacto}</a>
      </div>
      <div class="footer__col">
        <span class="footer__col-title" data-i18n="footer.legal">{t.legal}</span>
        <a href="#" class="footer__link" data-i18n="footer.terminos">{t.terminos}</a>
        <a href="#" class="footer__link" data-i18n="footer.privacidad">{t.privacidad}</a>
      </div>
    </nav>
  </div>

  <div class="container footer__bottom">
    <p class="footer__legal">
      <span data-i18n="footer.copyright">{t.copyright}</span> &copy; {new Date().getFullYear()} Monkey Computer
    </p>

    <p class="footer__legal footer__right" data-i18n="footer.madeWith">
      {t.madeWith}
    </p>
  </div>
</footer>

<style>
  .footer {
    padding-top: 0;
    padding-bottom: 2rem;
  }

  .footer__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    padding-block: 3rem;
    align-items: start;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .footer__logo:hover { opacity: 0.7; }

  .footer__tagline {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.35rem;
  }

  .footer__credit {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .footer__dot {
    color: var(--accent);
    margin-right: 0.25rem;
  }

  .footer__links {
    display: flex;
    gap: 3rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer__col-title {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-secondary);
    font-family: var(--font-mono);
    margin-bottom: 0.25rem;
  }

  .footer__link {
    font-size: 0.875rem;
    color: var(--text-muted);
    transition: color 0.2s;
    text-decoration: none;
  }

  .footer__link:hover { color: var(--text-primary); }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .footer__legal {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .footer__legal a {
    color: var(--text-muted);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    transition: color 0.2s;
    text-decoration: none;
  }

  .footer__legal a:hover { color: var(--text-secondary); }

  .footer__social {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 25px;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #6b7280;
    transition: color 0.2s;
    text-decoration: none;
  }

  .footer__social-link:hover { color: #9ca3af; }

  @media (max-width: 900px) {
    .footer__inner {
      grid-template-columns: 1fr;
    }

    .footer__links {
      flex-wrap: wrap;
      gap: 2rem;
    }
  }

  @media (max-width: 480px) {
    .footer__bottom {
      flex-direction: column;
      gap: 0.75rem;
      align-items: center;
      text-align: center;
    }
  }
</style>
